{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["server.ts", "config/**/*.ts", "middleware/**/*.ts", "models/**/*.ts", "routes/**/*.ts", "scripts/**/*.ts", "utils/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "uploads"]
}
